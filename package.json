{
  "name": "luvpame-browser-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun --bun wxt prepare",
    "dev": "bun --bun wxt",
    "build": "bun --bun wxt build",
    "typecheck": "bun --bun wxt prepare && bun --bun tsc --noEmit",
    "test": "vp test",
    "lint": "vp check",
    "format": "vp check --fix",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:bundle"
  },
  "dependencies": {
    "@wllama/wllama": "3.13.0",
    "@wllama/wllama-compat": "3.13.0",
    "defuddle": "0.18.1",
    "europa": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite-plus": "0.1.21",
    "wxt": "0.21.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.21"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13"
}

 export const createStorageChangeHandler = (refresh: () => void): (() => void) => refresh;
 
+export const isExtensionContextInvalidatedError = (error: unknown): boolean =>
+  error instanceof Error && error.message.includes("Extension context invalidated");
+
+export const createFeatureRefresher = (
+  getSettings: () => Promise<EnhancerSettings>,
+  apply: (settings: EnhancerSettings) => void,
+): { refresh: () => void; invalidate: () => void } => {
+  let invalidated = false;
+
+  const refresh = () => {
+    void getSettings()
+      .then((settings) => {
+        if (!invalidated) {
+          apply(settings);
+        }
+      })
+      .catch((error: unknown) => {
+        if (!invalidated || !isExtensionContextInvalidatedError(error)) {
+          throw error;
+        }
+      });
+  };
+
+  return {
+    refresh,
+    invalidate: () => {
+      invalidated = true;
+    },
+  };
+};

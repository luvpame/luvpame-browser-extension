+      if (!req.spec_draft_model.value.empty())
+        params.speculative.types = {COMMON_SPECULATIVE_TYPE_DRAFT_SIMPLE};
+    }
     if (req.spec_draft_ngl.not_null())
       params.speculative.draft.n_gpu_layers = req.spec_draft_ngl.value;

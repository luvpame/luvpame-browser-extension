Disable unused prompt cache and default context checkpoints.

Finished requests with cache_prompt disabled release their KV cells. Explicit checkpoint
requests remain supported.

diff --git a/cpp/wllama-context.h b/cpp/wllama-context.h
index 820c27c..9f72d22 100644
--- a/cpp/wllama-context.h
+++ b/cpp/wllama-context.h
@@ -786,6 +786,9 @@ struct wllama_context
       params.flash_attn_type = req.flash_attn.value ? LLAMA_FLASH_ATTN_TYPE_AUTO : LLAMA_FLASH_ATTN_TYPE_DISABLED;
     if (req.swa_full.not_null())
       params.swa_full = req.swa_full.value;
+    // Reading slot state back from WebGPU stalls each request.
+    params.cache_ram_mib = 0;
+    params.n_ctx_checkpoints = 0;
     if (req.n_ctx_checkpoints.not_null())
       params.n_ctx_checkpoints = req.n_ctx_checkpoints.value;
     if (req.checkpoint_min_step.not_null())
diff --git a/llama.cpp/tools/server/server-context.cpp b/llama.cpp/tools/server/server-context.cpp
index 78c8ef1..8fb7fc3 100644
--- a/llama.cpp/tools/server/server-context.cpp
+++ b/llama.cpp/tools/server/server-context.cpp
@@ -668,7 +668,7 @@ struct server_slot {
 
             // do not keep context of the child slots - the parent's context is enough
             // nor of the stateless slots - no task ever reuses it
-            if (task->is_child() || task->is_stateless() || audio_stream || task->type == SERVER_TASK_TYPE_REALTIME) {
+            if (task->is_child() || task->is_stateless() || !task->params.cache_prompt || audio_stream || task->type == SERVER_TASK_TYPE_REALTIME) {
                 prompt_clear();
             }
 

{"manifest_version":3,"name":"Luvpame Browser Extension","description":"GitHub・Notionの編集補助、Vim入力、Markdownコピーを一つに。","version":"1.0.0","icons":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"permissions":["storage","activeTab","scripting","clipboardWrite","notifications","offscreen"],"host_permissions":["https://github.com/*"],"commands":{"copy-markdown-link":{"suggested_key":{"default":"Ctrl+Shift+Y","mac":"Command+Shift+Y"},"description":"現在のタブのURLをMarkdownでコピー"}},"web_accessible_resources":[{"resources":["devin-redirect-icon.png"],"matches":["https://github.com/*"]}],"background":{"service_worker":"background.js"},"action":{"default_title":"Luvpame","default_popup":"popup.html"},"options_ui":{"open_in_tab":true,"page":"options.html"},"content_scripts":[{"matches":["https://app.devin.ai/*"],"js":["content-scripts/devin.js"]},{"matches":["https://github.com/*"],"css":["content-scripts/github.css"],"js":["content-scripts/github.js"]},{"matches":["https://*.notion.site/*","https://app.notion.com/*","https://www.notion.so/*"],"js":["content-scripts/notion.js"]},{"matches":["<all_urls>"],"js":["content-scripts/vim.js"]}]}